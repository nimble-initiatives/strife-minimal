---
import LivePreview from '@strifeapp/astro/LivePreview.astro';
import HomeContent from '../components/HomeContent.svelte';

// Read a localized value defensively: the content index may return a plain scalar
// (single-locale teams) or a locale-keyed object like { en: "…" }. Used here only
// for the <title>; HomeContent re-resolves the same way for its live updates.
function t(value: unknown, locale = 'en'): string {
  if (value == null) return '';
  if (typeof value === 'string') return value;
  if (typeof value === 'object') {
    const obj = value as Record<string, unknown>;
    const v = obj[locale] ?? Object.values(obj)[0];
    return typeof v === 'string' ? v : '';
  }
  return '';
}

// Placeholder copy until `strife` provisions the store and seeds the Home document
// (see strife.seed.json). Once seeded, the values below come from your content.
let heading: unknown = 'Your content, live from Strife';
let body: unknown =
  '<p>This page renders its heading and body straight from your Strife content store. Open Strife Studio, edit them, and watch the change land here in real time — no refresh, no rebuild.</p>';

// `Astro.locals.editMode` is set per request by the Strife edit-mode middleware
// (auto-registered by the integration) when a valid `?token=` preview is present.
const editMode = Astro.locals.editMode ?? false;

try {
  // Imported dynamically so a missing/invalid STRIFE_SECRET (the store module
  // self-initialises on import) is caught here rather than crashing the render —
  // the page degrades to the placeholder copy above until `strife` provisions it.
  const { store } = await import('strife:store');
  const session = store.openSession();
  // `strife push` deploys a `Content/ByUrl` index for URL-based lookups. The index
  // also emits rows for a document's live /draft (pending edits) and /scheduled
  // (pending publish) siblings, and they share the canonical's url — so always
  // filter on status, or firstOrNull may return unpublished content.
  // On this route the pathname is always `/`, so the result is safely cached. In a
  // catch-all route (`[...slug].astro`) add `.noCaching()`: a query keyed by the
  // request path adds a cache entry per distinct URL, scanner probes included.
  const byUrl = (status: string) =>
    session
      .query({ indexName: 'Content/ByUrl' })
      .whereEquals('url', Astro.url.pathname)
      .whereEquals('status', status)
      .firstOrNull();
  // Edit mode prefers the draft row so Studio previews pending edits on first
  // paint; HomeContent's `subscribe` takes over for subsequent keystrokes.
  const page = (editMode ? await byUrl('draft') : null) ?? (await byUrl('published'));
  if (page) {
    const p = page as Record<string, unknown>;
    if (p.heading != null) heading = p.heading;
    if (p.body != null) body = p.body;
  }
} catch (err) {
  // The store is unreachable (missing/invalid STRIFE_SECRET, or the schema hasn't
  // been pushed/seeded yet). Fall back to the placeholder copy so the page still
  // renders — run `strife` to provision, then `strife push`.
  console.warn('[strife] could not read content:', err instanceof Error ? err.message : err);
}

// Static starter chrome — these two cards are NOT Strife content, just the
// welcome links. Edit or remove them freely (or promote them into your schema).
const docsUrl = 'https://developers.strife.app';
const community = [
  { label: 'Slack', href: 'https://strife.app/en/join-community' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/company/strife-app' },
  { label: 'Contact us', href: 'https://strife.app/en/contact-us' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t(heading)}</title>
    <meta name="description" content="A minimal Astro site powered by Strife." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Loads the Strife live-preview SDK, but only in edit mode. Place once, like <ClientRouter />. -->
    <LivePreview />
    <style is:global>
      :root {
        color-scheme: dark;

        /* Brand */
        --accent: oklch(0.64 0.2 280); /* Strife purple, ≈ #6d5efc */
        --accent-bright: oklch(0.8 0.1 285); /* lighter purple for text, ≈ #bdb6ff */

        /* Surfaces — a near-black tinted toward the brand hue, not pure black */
        --bg: oklch(0.155 0.022 285);
        --surface: oklch(0.205 0.026 285);
        --surface-hover: oklch(0.24 0.03 285);

        /* Ink */
        --ink: oklch(0.96 0.008 285);
        --ink-muted: oklch(0.74 0.02 285);
        --ink-faint: oklch(0.58 0.026 285);

        /* Hairlines */
        --line: color-mix(in oklab, var(--ink), transparent 88%);

        /* Type — one clean sans throughout, matching the "Powered by Strife"
           wordmark. Display = body, separated by weight/size, not family. Sourced
           from the OS, so the starter ships zero font downloads. */
        --font-body: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        --font-display: var(--font-body);

        --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
      }

      :where(*, *::before, *::after) {
        box-sizing: border-box;
      }

      html {
        -webkit-text-size-adjust: 100%;
      }

      body {
        margin: 0;
        min-block-size: 100dvh;
        background-color: var(--bg);
        color: var(--ink);
        font-family: var(--font-body);
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      ::selection {
        background: color-mix(in oklab, var(--accent), transparent 65%);
        color: var(--ink);
      }
    </style>
  </head>
  <body>
    <!-- The heading + body render live from Strife; `client:load` hydrates the
         island so `subscribe` can stream Studio edits in without a refresh. -->
    <HomeContent
      client:load
      heading={t(heading)}
      body={t(body)}
      editMode={editMode}
      docsUrl={docsUrl}
      community={community}
    />
  </body>
</html>
