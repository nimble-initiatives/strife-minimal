---
import '../styles/global.css';
import LivePreview from '@strifeapp/astro/LivePreview.astro';
import HomeContent from '../components/HomeContent.svelte';
// `Home` is generated by `strife typegen generate` into .strife/types.ts
// (gitignored, regenerated). Run it after editing schemas/ — the page still
// renders without it (type-only import is erased), but type-checks need it.
import type { Home } from '../../.strife/types';

// Placeholder copy until `strife` provisions the store and seeds the Home document
// (strife.seed.json). Once seeded, these come straight from your content.
let heading = 'Your content, live from Strife';
let body =
  '<p>This page renders its heading and body straight from your Strife content store. Open Strife Studio, edit them, and watch the change land here live — no refresh, no rebuild.</p>';

try {
  // Dynamic import so a missing STRIFE_SECRET degrades to the placeholder above
  // instead of crashing the render (the store self-initialises on import).
  const { store } = await import('strife:store');
  const page = (await store
    .openSession()
    .query({ indexName: 'Content/ByUrl' })
    .whereEquals('url', Astro.url.pathname)
    .firstOrNull()) as Home | null;
  if (page?.heading != null) heading = page.heading;
  if (page?.body != null) body = page.body;
} catch (err) {
  console.warn('[strife] could not read content:', err instanceof Error ? err.message : err);
}

const editMode = Astro.locals.editMode ?? false;

// Static starter chrome (not Strife content) — edit or remove freely.
const docsUrl = 'https://developers.strife.app';
const community = [
  { label: 'Slack', href: 'https://strife.app/en/join-community' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/company/strife-app' },
  { label: 'Contact us', href: 'https://strife.app/en/contact-us' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{heading}</title>
    <meta name="description" content="A minimal Astro site powered by Strife." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Loads the Strife live-preview SDK, but only in edit mode. Place once, like <ClientRouter />. -->
    <LivePreview />
  </head>
  <body>
    <!-- heading + body render live from Strife; client:load hydrates the island so
         `subscribe` can stream Studio edits in without a refresh. -->
    <HomeContent
      client:load
      heading={heading}
      body={body}
      editMode={editMode}
      docsUrl={docsUrl}
      community={community}
    />
  </body>
</html>
